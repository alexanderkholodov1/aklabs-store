rules_version = '2';

// Deny by default. Nothing in the app reads or writes Firestore from the
// browser yet, so every client request is refused. Jobs that run with the
// Admin SDK (CI, scheduled tasks) are not affected by these rules.
//
// When orders and history move to Firestore (roadmap v0.4), each collection
// gets its own match block that only lets a signed-in user (anonymous
// included) touch their own documents, with schema validation, plus
// emulator tests in CI.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
