{
  "name": "@dtc/storefront",
  "version": "1.0.3",
  "private": true,
  "author": "Kasper Fabricius Kristensen <kasper@medusajs.com> & Victor Gerbrands <victor@medusajs.com> (https://www.medusajs.com)",
  "description": "A bilingual, static shopping simulator for AKLabs",
  "keywords": [
    "medusa-storefront"
  ],
  "scripts": {
    "dev": "next dev --turbopack -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src scripts --ext .ts,.tsx,.mjs",
    "analyze": "ANALYZE=true next build",
    "catalog:build": "node scripts/catalog/build.mjs",
    "build:site": "pnpm run catalog:build && next build && node scripts/offline.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.0.5",
    "react-dom": "19.0.5"
  },
  "devDependencies": {
    "@types/node": "17.0.21",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.4.8",
    "prettier": "^2.8.8",
    "typescript": "^5.3.2",
    "sharp": "0.34.5",
    "playwright": "1.58.2",
    "@axe-core/playwright": "4.11.1"
  },
  "packageManager": "pnpm@11.5.2"
}
