# Copia este archivo como .env.local (cp .env.example .env.local) y completa los valores.

# Clave publicable de la Store API.
# Admin (http://localhost:9000/app) > Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_reemplazar

# URL del backend Medusa
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Region por defecto cuando la URL no trae pais: ec = Ecuador (USD)
NEXT_PUBLIC_DEFAULT_REGION=ec

# URL publica de este storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Opcional: solo si se habilita Stripe en el backend
NEXT_PUBLIC_STRIPE_KEY=
